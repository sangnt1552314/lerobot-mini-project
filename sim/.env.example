# Simulation settings. Copy to sim/.env and edit:  cp sim/.env.example sim/.env
# sim/.env is gitignored. If it does not exist the scripts use this file's defaults.
# No credentials belong here; log in with `huggingface-cli login` / `wandb login` instead.

# ---- environment -------------------------------------------------------------
SIM_CONDA_ENV=leisaac_sim
# LeIsaac checkout. Empty = sim/third_party/leisaac, cloned by setup.sh at LEISAAC_REF.
LEISAAC_ROOT=
LEISAAC_REF=24d3bcd3f1e4585740fc79921782c41617237812
# Uncomment to accept the NVIDIA Omniverse EULA non-interactively (you must agree to it).
# OMNI_KIT_ACCEPT_EULA=YES

# ---- dataset -----------------------------------------------------------------
# Dataset id = ${HF_USER}/${SIM_DATASET_NAME}. Nothing is pushed to the Hub; "local" is fine.
HF_USER=local
SIM_TASK=LeIsaac-SO101-LiftCube-DualCam-v0
SIM_DATASET_NAME=so101_liftcube_dualcam_sim
# Datasets live in ${SIM_DATA_ROOT}/lerobot/<repo id>. Empty = sim/data.
SIM_DATA_ROOT=
NUM_DEMOS=100
DATASET_FPS=30

# ---- ACT training --------------------------------------------------------------
TRAIN_STEPS=20000
SMOKE_TRAIN_STEPS=10000
BATCH_SIZE=8
SAVE_FREQ=5000
DEVICE=cuda
# Relative paths are relative to the repository root.
OUTPUT_DIR=outputs/act_liftcube
WANDB_ENABLE=true
WANDB_PROJECT=so101_liftcube_sim

# ---- evaluation ---------------------------------------------------------------
EVAL_EPISODES=20
